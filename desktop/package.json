{
  "name": "shrewdness-desktop",
  "productName": "Shrewdness",
  "version": "1.0.0",
  "description": "The Shrewdness IDE as a desktop application",
  "main": "main.js",
  "author": "Lowe Wady",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "io.shrewdness.ide",
    "productName": "Shrewdness",
    "files": [
      "main.js",
      "menu.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../examples",
        "to": "examples"
      },
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "artifactName": "Shrewdness-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
