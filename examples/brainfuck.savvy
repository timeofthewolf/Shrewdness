var tape[256];

fn strlen(s) {
    var i = 0;
    while (s[i] != 0) { i = i + 1; }
    return i;
}

fn run_bf(src) {
    var len = strlen(src);
    var pc = 0;
    var p = 0;

    while (pc < len) {
        var c = src[pc];

        if (c == '>') { p = p + 1; }
        if (c == '<') { p = p - 1; }
        if (c == '+') { tape[p] = (tape[p] + 1) % 256; }
        if (c == '-') { tape[p] = (tape[p] + 255) % 256; }
        if (c == '.') { putchar(tape[p]); }
        if (c == ',') { tape[p] = input(); }

        if (c == '[' && tape[p] == 0) {
            var depth = 1;
            while (depth > 0 && pc < len) {
                pc = pc + 1;
                if (src[pc] == '[') { depth = depth + 1; }
                if (src[pc] == ']') { depth = depth - 1; }
            }
        }

        if (c == ']' && tape[p] != 0) {
            var depth = 1;
            while (depth > 0 && pc > 0) {
                pc = pc - 1;
                if (src[pc] == ']') { depth = depth + 1; }
                if (src[pc] == '[') { depth = depth - 1; }
            }
            pc = pc - 1;
        }

        pc = pc + 1;
    }
    return 0;
}

var hello = "++++++++[>++++[>++>+++>+++>+<<<<-]>+>+>->>+[<]<-]>>.>---.+++++++..+++.>>.<-.<.+++.------.--------.>>+.>++.";

run_bf(hello);
putchar('\n');
